+#ifndef VN_RENDERER_HELIOS_E1_TRACE_H
+#define VN_RENDERER_HELIOS_E1_TRACE_H
+#include <stdint.h>
+/* Per-process bounded diagnostic budget. Disabled must never reserve IDs.
+ * Caller serializes through the ICD's atomic record counter, not an E1 lock. */
+#define HELIOS_E1_TRACE_LIMIT 2048u
+static inline int helios_e1_trace_admit(int enabled, uint32_t ordinal)
+{ return enabled && ordinal > 0 && ordinal <= HELIOS_E1_TRACE_LIMIT; }
+#endif
