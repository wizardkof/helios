+"""Actual diagnostic emitter with Win32 seams; CPU-only, no renderer build."""
+from pathlib import Path
+import subprocess,sys
+root=Path(__file__).parent;source=(root/'vn_renderer_helios.c').read_text()
+def body(name):
+ a=source.index('\n'+name+'(')+1;b=source.index('{',a);depth=1;i=b+1
+ while depth:depth+=(source[i]=='{')-(source[i]=='}');i+=1
+ return source[a:i]
+unit=r'''
+#include "vn_renderer_helios_e1_trace.h"
+#include <assert.h>
+#include <stdbool.h>
+#include <stdio.h>
+#include <string.h>
+typedef long LONG;typedef void* HANDLE;
+struct helios{int unused;};struct helios_sync{unsigned char carrier_id[16];};
+static int enabled;static unsigned emitted,truncated;
+static int GetEnvironmentVariableA(const char*n,char*b,unsigned z){(void)n;assert(z>=2);if(!enabled)return 0;b[0]='1';b[1]=0;return 1;}
+static bool helios_p06_diag_enabled(void){return enabled;}
+static LONG InterlockedCompareExchange(volatile LONG*p,LONG n,LONG old){LONG v=*p;if(v==old)*p=n;return v;}
+static void helios_p06_wait_diag(struct helios*h,const char*op,uint64_t fence,const char*fields){(void)h;assert(!fence);assert(strlen(fields)<768);emitted++;if(!strcmp(op,"E1_TRACE_TRUNCATED"))truncated++;}
+'''
+unit+='\nstatic bool\n'+body('helios_e1_trace_enabled')+'\nstatic void\n'+body('helios_e1_trace')
+unit+=r'''
+int main(void){struct helios h={0};struct helios_sync sync={{1}};
+ helios_e1_trace(&h,"E1_REGISTER",&sync,9,(HANDLE)1,17,1,0,0);assert(!emitted);
+ enabled=1;for(unsigned i=0;i<2100;i++)helios_e1_trace(&h,"E1_REGISTER",&sync,9,(HANDLE)1,17,1,0,0);
+ assert(emitted==2049&&truncated==1);return 0;
+}
+'''
+out=Path(sys.argv[1]).resolve();out.with_suffix('.c').write_text(unit)
+subprocess.run(['cc','-std=c11','-Wall','-Wextra','-Werror','-I',str(root),str(out.with_suffix('.c')),'-o',str(out)],check=True);subprocess.run([str(out)],check=True)
